{
  "name": "s-escapes-astro-tina",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:site": "astro dev",
    "build": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "build:site": "astro build",
    "build:cms": "tinacms build --local --skip-cloud-checks",
    "build:cloud": "tinacms build -c \"astro build\"",
    "verify": "npm run check && astro build && node --check netlify/functions/leads.mjs && node --check netlify/functions/reviews.mjs && node --check netlify/functions/lib/shared.mjs",
    "preview": "astro preview",
    "check": "astro check"

  },
  "dependencies": {
    "astro": "^7.1.0",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
