# TinaCloud credentials. Local editing works without them through `npm run dev`.
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=

# Canonical production URL used by Astro for absolute URLs and the sitemap.
PUBLIC_SITE_URL=https://s-escapes.com

# Netlify Functions / Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=S-Escapes <contact@s-escapes.com>
LEAD_RECIPIENT=sescapes.travelplanner@gmail.com
