---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { pilgrimagePage as page, siteSettings } from '../lib/content'
import '../spiritual.css'

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.items.map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } }))
}
---

<BaseLayout title={page.seo.title} description={page.seo.description} image={page.seo.image} noIndex={page.seo.noIndex} themeColor="#0c1310" sacred schema={faqSchema}>
  <Header variant="sacred" />
  <main id="contenu">
    <section class="cover cover--sacred" id="haut">
      <picture class="cover-photo" aria-hidden="true">{page.hero.imageMobile && <source srcset={page.hero.imageMobile} media="(max-width: 720px)" />}<img src={page.hero.image} alt="" fetchpriority="high" width="1672" height="941" /></picture>
      <div class="cover-inner"><p class="cover-kicker">{page.hero.kicker}</p><h1><span class="line">{page.hero.heading}</span><span class="line line--accent">{page.hero.headingAccent}</span></h1><p class="cover-sub">{page.hero.intro}</p><div class="cover-actions"><a class="pill pill--solid" href="#chemin">{page.hero.primaryCta}</a><a class="pill" href="#formules">{page.hero.secondaryCta}</a></div></div>
      <div class="cover-strip" aria-hidden="true"><span>{page.hero.stripLeft}</span><span class="strip-route"><b></b></span><span>{page.hero.stripRight}</span></div>
    </section>

    <section class="sacred-choice" aria-labelledby="choice-title"><header><SectionHeading section={page.choices} id="choice-title" /></header><div class="choice-grid">{page.choices.items.map(item => <article><h3>{item.title}</h3><p>{item.copy}</p><dl>{item.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl><a class="text-link" href={item.href}>{item.cta}</a></article>)}</div></section>

    <section class="chemin" id="chemin"><header class="sect-head reveal"><SectionHeading section={page.journey} /></header><div class="stage-grid">{page.journey.stages.map((stage, index) => <article class="stage reveal"><figure><img src={stage.image} alt={stage.imageAlt} loading="lazy" /><span>{String(index + 1).padStart(2, '0')}</span></figure><h3>{stage.title}</h3><ul>{stage.items.map(item => <li><strong>{item.title}</strong><small>{item.copy}</small></li>)}</ul></article>)}</div></section>

    <section class="sacred" id="hajj"><figure class="sacred-photo reveal" aria-hidden="true"><img src={page.hajjPromo.image} alt="" loading="lazy" /></figure><div class="sacred-copy reveal"><SectionHeading section={page.hajjPromo} /><p class="lede">{page.hajjPromo.intro}</p><a class="pill" href="#rappel">{page.hajjPromo.cta}</a></div></section>

    <section class="practical" aria-labelledby="practical-title"><header><SectionHeading section={page.practical} id="practical-title" /></header><div class="practical-grid">{page.practical.columns.map(column => <article><h3>{column.title}</h3><ul>{column.items.map(item => <li>{item}</li>)}</ul></article>)}</div></section>

    <section class="fares" id="formules"><header class="sect-head reveal"><SectionHeading section={page.packages} /></header><div class="fare-list">{page.packages.items.map(item => <article class:list={['fare', 'reveal', item.featured && 'fare--featured']}>{item.featured && item.badge && <p class="fare-badge">{item.badge}</p>}<div class="fare-id"><h3>{item.name}</h3><p>{item.tagline}</p></div><dl>{item.features.map(feature => <div><dt>{feature.label}</dt><dd>{feature.value}</dd></div>)}</dl><div class="fare-cta"><strong>{item.price}</strong><button class:list={['pill', item.featured && 'pill--solid']} type="button" data-formula={item.name}>{item.cta}</button></div></article>)}</div></section>

    <section class="preparation" aria-labelledby="preparation-title"><header><SectionHeading section={page.preparation} id="preparation-title" /></header><ol>{page.preparation.items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div></li>)}</ol></section>

    <section class="faq" aria-labelledby="faq-title"><header><SectionHeading section={page.faq} id="faq-title" /></header><div class="faq-list">{page.faq.items.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>

    <section class="contact" id="rappel">
      <div class="contact-copy reveal"><SectionHeading section={page.contact} /><p class="lede">{page.contact.intro}</p><p class="response-promise" data-response-promise hidden></p><div class="contact-direct"><a href={`tel:${siteSettings.contact.phoneHref}`}>{siteSettings.contact.phoneDisplay}</a><a href={`mailto:${siteSettings.contact.email}`}>{siteSettings.contact.email}</a></div><p class="contact-hours">{siteSettings.contact.hours}</p></div>
      <form class="contact-form reveal" data-callback-form>
        <label>Nom<input name="name" autocomplete="name" required /></label><label>E-mail<input name="email" type="email" autocomplete="email" required /></label><label>Téléphone<input name="phone" type="tel" autocomplete="tel" required /></label><label>Préférence de contact<select name="contactPreference" required><option value="">Sélectionner</option><option>Appel téléphonique</option><option>WhatsApp</option><option>E-mail</option></select></label><label>Type de voyage<select name="type" required><option value="">Sélectionner</option>{page.packages.items.map(item => <option>{item.name}</option>)}<option>Hajj</option></select></label><label>Période souhaitée<input name="period" placeholder="Ex. : mars 2027" required /></label><label>Créneau préféré<select name="contactTime" required><option value="">Sélectionner</option><option>Le matin</option><option>L’après-midi</option><option>En soirée</option><option>Selon vos disponibilités</option></select></label><label class="consent field-wide"><input name="consent" type="checkbox" required /> J’accepte d’être contacté(e) par S Escapes au sujet de mon projet et la <a href="/confidentialite">Politique de confidentialité</a>.</label><button class="pill pill--solid" type="submit">{page.contact.submitLabel}</button><p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <section class="form-success" data-form-success hidden aria-live="polite"><p class="sect-label">Demande bien reçue</p><h3>{page.contact.successTitle}</h3><p>{page.contact.successCopy} <span data-response-time></span></p></section>
    </section>
  </main>
  <Footer variant="sacred" />
  <script>import '../spiritual.js'</script>
</BaseLayout>
