---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { destinationByReference, trips, tripByReference, siteSettings } from '../../lib/content'
import '../../destination.css'

export function getStaticPaths() {
  return trips.map(trip => ({ params: { slug: trip.slug }, props: { trip } }))
}

const { trip }: { trip: any } = Astro.props
const alternatives: any[] = (trip.alternatives || []).map((item: any) => tripByReference(item.destination || item.trip || item) || destinationByReference(item.destination || item)).filter(Boolean)
const tripTitle = trip.title || trip.name
const tripDescription = trip.description || trip.copy
const tripImage = trip.coverImage || trip.image
const adaptHref = `/?destination=${encodeURIComponent(tripTitle)}#atelier`
const tripSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: tripTitle,
  description: tripDescription,
  itinerary: {
    '@type': 'ItemList',
    itemListElement: (trip.itinerary || []).map((item: any, position: number) => ({ '@type': 'ListItem', position: position + 1, name: item.title }))
  }
}
const publicTrip = { name: tripTitle, slug: trip.slug }
---

<BaseLayout title={trip.seo?.title || `${tripTitle} — S Escapes`} description={trip.seo?.description || tripDescription} image={trip.seo?.image || tripImage} canonicalPath={`/voyages/${trip.slug}`} noIndex={trip.seo?.noIndex} schema={tripSchema}>
  <Header variant="destination" />
  <main id="contenu">
    <section class="cover cover--voyage" id="haut">
      <picture class="cover-photo" aria-hidden="true"><img src={tripImage} alt="" fetchpriority="high" /></picture>
      <div class="cover-inner">
        <a class="back-link" href="/#departs">← Index des départs</a>
        <p class="cover-kicker">{trip.coords}</p>
        <h1><span class="line">{tripTitle}</span></h1>
        <p class="cover-sub cover-sub--accent">{trip.subtitle}</p>
        <div class="cover-actions"><a class="pill pill--solid" href="#contact-voyage">Recevoir le programme</a><a class="pill" href={adaptHref}>Adapter ce voyage</a></div>
      </div>
      <div class="cover-strip cover-strip--meta"><span>{trip.duration}</span><span class="strip-route" aria-hidden="true"><b></b></span><span class="strip-price">{trip.price}</span></div>
      <dl class="voyage-summary" aria-label="Repères du voyage"><div><dt>Période idéale</dt><dd>{trip.idealPeriod}</dd></div><div><dt>Style</dt><dd>{trip.style}</dd></div></dl>
    </section>

    <section class="story" id="essentiel">
      <figure class="story-photo polaroid reveal" data-tilt><img src={trip.secondaryImage} alt={`Carnet visuel de voyage — ${tripTitle}`} loading="lazy" /><figcaption>{trip.note}</figcaption></figure>
      <div class="story-copy reveal"><p class="sect-label"><i>01</i>L’essentiel</p><h2>{trip.subtitle}</h2><p class="lede">{tripDescription}</p><a class="pill" href="#programme">Voir l’itinéraire</a></div>
    </section>

    <section class="plan" id="programme">
      <div class="plan-main reveal"><p class="sect-label"><i>02</i>Le programme</p><h2>Un itinéraire<br />pensé pour <em>vous</em>.</h2>
        <ol class="itinerary">{trip.itinerary.map((item: any, index: number) => <li style={`--delay:${index * .09}s`}><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item.title}</strong><small>{item.copy}</small></div></li>)}</ol>
      </div>
      <aside class="plan-aside reveal"><div><p class="sect-label"><i>03</i>Dans votre carnet</p><h3>Ce qui est inclus</h3><ul class="includes">{trip.includes.map((item: string) => <li>{item}</li>)}</ul><h3>À prévoir</h3><ul class="includes includes--prepare">{trip.prepare.map((item: string) => <li>{item}</li>)}</ul><a class="text-link" href={adaptHref}>Imaginer ce voyage pour moi</a></div></aside>
    </section>

    {alternatives.length > 0 && <section class="alternatives"><header><p class="sect-label"><i>04</i>À prolonger</p><h2>D’autres départs<br />à <em>imaginer</em>.</h2></header><div class="alternative-list">{alternatives.map((candidate: any) => <a href={`/voyages/${candidate.slug}`}><img src={candidate.image} alt={candidate.name} loading="lazy" /><span>{candidate.name}</span><small>{candidate.price}</small></a>)}</div></section>}

    <section class="contact" id="contact-voyage">
      <div class="contact-copy reveal"><p class="sect-label"><i>05</i>Votre demande</p><h2>Parlons de<br />ce <em>voyage</em>.</h2><p class="lede">Recevez le programme détaillé ou demandez-nous d’adapter ce départ à vos dates, votre rythme et votre budget.</p><div class="contact-direct"><a href={`tel:${siteSettings.contact.phoneHref}`}>{siteSettings.contact.phoneDisplay}</a><a href={`mailto:${siteSettings.contact.email}`}>{siteSettings.contact.email}</a></div></div>
      <form class="contact-form reveal" data-voyage-form>
        <label>Nom et prénom<input name="name" autocomplete="name" required /></label><label>E-mail<input name="email" type="email" autocomplete="email" required /></label><label>Téléphone<input name="phone" type="tel" autocomplete="tel" /></label><label>Ville de départ<input name="departureCity" autocomplete="address-level2" /></label><label>Période souhaitée<input name="period" placeholder="Ex. : juin 2027" /></label><label class="field-wide">Votre message<textarea name="message" rows="4"></textarea></label><label class="consent field-wide"><input name="consent" type="checkbox" required /> J’accepte d’être recontacté(e) au sujet de ce voyage et la <a href="/confidentialite">Politique de confidentialité</a>.</label><button class="pill pill--solid" type="submit">Recevoir le programme</button><p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <section class="form-success" data-form-success hidden aria-live="polite"><p class="sect-label">Demande bien reçue</p><h3>Le programme arrive bientôt.</h3><p>Merci pour votre confiance. <span data-response-time></span></p></section>
    </section>
  </main>
  <Footer variant="destination" />
  <script is:inline define:vars={{ publicTrip }}>window.S_ESCAPES_TRIP = publicTrip</script>
  <script>import '../../destination.js'</script>
</BaseLayout>
